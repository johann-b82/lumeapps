{
	# Wie in der Basisdatei: HTTP, kein Zertifikatsmanagement. TLS liegt beim
	# vorgelagerten Netz bzw. kommt in Phase 5.
	auto_https off
	admin off
}

:80 {
	# --- Rumpfgrenze (Befund 10) -----------------------------------------------
	# 64 MB deckt den groessten echten Weg ab (50 MB Signage-PPTX plus
	# multipart-Rahmen). Alles darueber wird an der Kante abgewiesen, statt in
	# pandas/openpyxl im Speicher zu landen.
	request_body {
		max_size 64MB
	}

	# --- Sicherheits-Kopfzeilen (Befund 5) -------------------------------------
	# Bewusst nur Kopfzeilen, die nichts laden koennen: nosniff, Herkunft und
	# Einbettung. Eine vollstaendige Content-Security-Policy mit default-src
	# fehlt noch — die will erst unter dem gebauten Bundle durchgeklickt sein,
	# sonst bricht sie im Betrieb Bilder oder Skripte weg.
	# Strict-Transport-Security kommt mit TLS dazu; ueber HTTP waere sie wirkungslos.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		# Nur der eigene Ursprung darf einbetten — der Signage-Player holt seine
		# /embed/*-Seiten von genau hier.
		Content-Security-Policy "frame-ancestors 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	# --- /api/* → FastAPI (SSE muss durchkommen) -------------------------------
	# Unveraendert gegenueber der Entwicklungsfassung: flush_interval -1 und
	# lange Timeouts, sonst kappt Caddy die Player-Streams.
	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
			transport http {
				read_timeout 24h
				write_timeout 24h
				dial_timeout 10s
			}
		}
	}

	# --- /directus/* → Directus (Praefix wird entfernt) ------------------------
	handle_path /directus/* {
		reverse_proxy directus:8055
	}

	# --- /player/* → FastAPI (Kiosk-Bundle) ------------------------------------
	# Bleibt bei FastAPI: dort haengt der StaticFiles-Mount, und die Pis
	# erwarten genau diesen Weg.
	handle /player/* {
		reverse_proxy api:8000
	}

	# --- / (alles Uebrige) → gebaute Oberflaeche -------------------------------
	# Der einzige echte Unterschied zur Entwicklungsfassung: statt eines
	# Reverse-Proxy auf den Vite-Dev-Server liefert Caddy die gebauten Dateien
	# selbst aus. try_files faengt die Client-Routen der Single-Page-App ab.
	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
		level ERROR
	}
}
